# ThetaData Nexus Cloud API Key (Keep secret - do not commit .env to GitHub)
THETADATA_API_KEY=your_thetadata_api_key_here

# Hostinger Database Configuration
# Supports: mysql (Hostinger default), postgresql, or sqlite (fallback)
DB_ENGINE=mysql
DB_HOST=localhost
DB_PORT=3306
DB_NAME=u123456789_gamma
DB_USER=u123456789_gammauser
DB_PASSWORD=your_hostinger_db_password

# Subpath deployment prefix (set to /gamma when hosted at reil.studio/gamma)
ROOT_PATH=/gamma

# Optional Alert Notifications (No third-party developer accounts needed)
# Discord: Create a Webhook on any channel in your Discord server
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR_WEBHOOK_URL_HERE
# Telegram: Create a bot with @BotFather and message @userinfobot for your chat ID
# TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
# TELEGRAM_CHAT_ID=your_telegram_chat_id_here

